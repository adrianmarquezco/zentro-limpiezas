---
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[]; lang?: 'es' | 'gl' }

const { headings, lang = 'es' } = Astro.props;
const items = headings.filter(h => h.depth === 2);
const title = lang === 'gl' ? 'Neste artigo' : 'En este artículo';
---

{items.length >= 2 && (
  <nav aria-label={title} class="toc not-prose mb-10 rounded-2xl border border-line bg-warm p-5 sm:p-6">
    <p class="font-display text-lg text-primary mb-3 flex items-center gap-2">
      <svg class="text-accent shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
      {title}
    </p>
    <ol class="space-y-1.5">
      {items.map((h, i) => (
        <li class="flex items-baseline gap-3 text-sm sm:text-base">
          <span class="font-mono text-xs text-accent font-bold shrink-0 w-5">{String(i + 1).padStart(2, '0')}</span>
          <a href={`#${h.slug}`} class="text-charcoal hover:text-accent underline-offset-4 hover:underline transition-colors">{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
