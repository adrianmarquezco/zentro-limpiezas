---
import { BUSINESS } from '@/data/config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CleaningService',
  '@id': `${BUSINESS.url}/#business`,
  name: BUSINESS.name,
  image: `${BUSINESS.url}/images/logo.png`,
  logo: `${BUSINESS.url}/images/logo.png`,
  telephone: BUSINESS.phoneHref.replace('tel:', ''),
  url: BUSINESS.url,
  priceRange: BUSINESS.priceRange,
  paymentAccepted: BUSINESS.payments.join(', '),
  currenciesAccepted: BUSINESS.currency,
  description: `Servicio profesional de limpieza de viviendas, oficinas, locales, cristales, comunidades, pazos y apartamentos turísticos en Ferrol, A Coruña y toda Ferrolterra. Productos ecológicos incluidos en el precio. Equipo con más de ${BUSINESS.yearsExperience} años de experiencia en el sector.`,
  sameAs: [
    'https://zentrolimpiezas.es',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: BUSINESS.address.locality,
    addressRegion: BUSINESS.address.region,
    addressCountry: BUSINESS.address.countryCode,
  },
  geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.latitude, longitude: BUSINESS.geo.longitude },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: BUSINESS.hours.attention.weekdays.open, closes: BUSINESS.hours.attention.weekdays.close },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: BUSINESS.hours.attention.saturday.open, closes: BUSINESS.hours.attention.saturday.close },
  ],
  areaServed: [
    'Ferrol','A Coruña','Narón','Neda','Fene','Mugardos','Valdoviño','Ares',
    'Moeche','San Sadurniño','Cabanas','Pontedeume','Cedeira','Ortigueira','Cerdido',
    'Culleredo','Arteixo','Cambre','Oleiros','Sada','Bergondo','Abegondo',
    'Carral','Betanzos','Paderne','Oza-Cesuras','Coirós','Irixoa','Vilarmaior',
  ].map(n => ({ '@type': 'City', name: n })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de limpieza ecológica',
    itemListElement: [
      'Limpieza de viviendas','Limpieza de pisos','Limpieza periódica',
      'Limpieza a fondo','Limpieza de cristales','Limpieza de apartamentos turísticos',
      'Limpieza de locales comerciales','Limpieza de oficinas','Limpieza de comunidades',
      'Limpieza de garajes','Limpieza de trasteros','Limpieza de mudanzas',
      'Limpieza de tapicerías','Limpieza fin de obra','Limpieza de pazos y eventos',
      'Desinfección de viviendas y locales',
    ].map(n => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
