---
import { BUSINESS } from '@/data/config';

interface Props {
  name: string;
  description: string;
  url: string;
  price?: string;
  areaServed?: string[];
}
const { name, description, url, price, areaServed } = Astro.props;

const defaultArea = ['Ferrol','A Coruña','Narón','Ferrolterra','Área Metropolitana de A Coruña'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name,
  description,
  url,
  provider: {
    '@type': 'LocalBusiness',
    name: BUSINESS.name,
    telephone: BUSINESS.phoneHref,
    url: BUSINESS.url,
    areaServed: defaultArea.map(n => ({ '@type': 'City', name: n })),
  },
  areaServed: (areaServed ?? defaultArea).map(n => ({ '@type': 'City', name: n })),
  ...(price ? { offers: { '@type': 'Offer', price, priceCurrency: 'EUR', availability: 'https://schema.org/InStock' } } : {}),
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
