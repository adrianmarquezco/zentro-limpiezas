---
import { BUSINESS } from '@/data/config';

interface Props {
  name: string;
  description: string;
  url: string;
  price?: string;
  areaServed?: string[];
  image?: string;
}
const { name, description, url, price, areaServed, image } = Astro.props;

const defaultArea = ['Ferrol','A Coruña','Narón','Ferrolterra','Área Metropolitana de A Coruña'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Cleaning Service',
  name,
  description,
  url,
  ...(image ? { image } : {}),
  provider: {
    '@type': 'CleaningService',
    '@id': `${BUSINESS.url}/#business`,
    name: BUSINESS.name,
  },
  areaServed: (areaServed ?? defaultArea).map(n => ({ '@type': 'City', name: n })),
  ...(price ? {
    offers: {
      '@type': 'Offer',
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: price,
        priceCurrency: 'EUR',
      },
    },
  } : {}),
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
