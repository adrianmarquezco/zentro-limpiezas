---
import { BUSINESS } from '@/data/config';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import SchemaLocalBusiness from '@/components/schema/SchemaLocalBusiness.astro';
import CookieBanner from '@/components/ui/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  lang?: 'es' | 'gl';
  hreflangEs?: string;
  hreflangGl?: string;
  robots?: string;
  schema?: object;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  preloadHero?: boolean;
}

const {
  title: rawTitle,
  description,
  canonical,
  ogImage = `${BUSINESS.url}/images/hero-equipo.webp`,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = 'website',
  lang = 'es',
  hreflangEs,
  hreflangGl,
  robots,
  schema,
  pageType = 'WebPage',
  preloadHero = false,
} = Astro.props;

// Los títulos largos se truncan en Google: se quita la marca cuando no caben en 65 caracteres
const BRAND_SUFFIX = ' | Zentro Limpiezas';
const title = rawTitle.length > 65 && rawTitle.endsWith(BRAND_SUFFIX) ? rawTitle.slice(0, -BRAND_SUFFIX.length) : rawTitle;

const canonicalUrl = canonical ?? `${BUSINESS.url}${Astro.url.pathname}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0A2540" />

  <!-- SEO básico -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {(robots || import.meta.env.PUBLIC_NOINDEX === 'true') && (
    <meta name="robots" content={import.meta.env.PUBLIC_NOINDEX === 'true' ? 'noindex, nofollow' : robots} />
  )}
  <link rel="canonical" href={canonicalUrl} />

  <!-- hreflang -->
  {hreflangEs && <link rel="alternate" hreflang="es" href={hreflangEs} />}
  {hreflangGl && <link rel="alternate" hreflang="gl" href={hreflangGl} />}
  {hreflangEs && <link rel="alternate" hreflang="x-default" href={hreflangEs} />}

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Zentro Limpiezas" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />
  <meta property="og:locale" content={lang === 'gl' ? 'gl_ES' : 'es_ES'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Tipografías alojadas en el propio dominio (@font-face en global.css); precarga de las del hero -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-sans.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-serif-display.woff2" crossorigin />
  <!-- Favicon + PWA -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="apple-touch-icon" href="/images/logo.png" />
  <link rel="manifest" href="/manifest.json" />

  {preloadHero && (
    <link rel="preload" as="image" href="/images/hero-equipo.webp" fetchpriority="high" />
  )}

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.__loadGtag = function () {
      if (document.getElementById('ga4-gtag')) return;
      var s = document.createElement('script');
      s.id = 'ga4-gtag';
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-5RLHF43D5D';
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', 'G-5RLHF43D5D');
    };
    if (localStorage.getItem('zentro_cookie_consent') === 'accepted') {
      window.__loadGtag();
    }
  </script>

  <!-- WebSite schema (activa Sitelinks Search Box en Google) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${BUSINESS.url}/#website`,
    url: BUSINESS.url,
    name: BUSINESS.name,
    inLanguage: ['es', 'gl'],
    publisher: { '@id': `${BUSINESS.url}/#business` },
  })} />

  <!-- Speakable schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': pageType,
    '@id': canonicalUrl,
    url: canonicalUrl,
    isPartOf: { '@id': `${BUSINESS.url}/#website` },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.speakable-intro', 'h1'],
    },
  })} />

  <!-- Schema global -->
  <SchemaLocalBusiness />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>

<body class="bg-warm font-sans antialiased">
  <Header lang={lang} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
  <CookieBanner lang={lang} />
  <noscript>
    <style>
      [data-reveal],[data-reveal-left],[data-reveal-right],[data-reveal-stagger] > * { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>

  <script src="/scripts/bootstrap.js" defer></script>
</body>
</html>
