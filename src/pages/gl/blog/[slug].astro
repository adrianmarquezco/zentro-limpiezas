---
import BlogLayout from '@/layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';
import { BUSINESS } from '@/data/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog-gl', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const canonical = `${BUSINESS.url}/gl/blog/${post.slug}/`;
const hreflangEs = post.data.slugEs ? `${BUSINESS.url}/blog/${post.data.slugEs}/` : undefined;

// Artigos relacionados: mesma categoría, excluíndo o actual, os máis recentes primeiro
const allPosts = await getCollection('blog-gl', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.data.category === post.data.category && p.slug !== post.slug)
  .sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime())
  .slice(0, 4)
  .map((p) => ({
    slug: p.slug,
    title: p.data.title,
    description: p.data.description,
    image: p.data.image,
    category: p.data.category,
  }));

const breadcrumbs = [
  { label: 'Blog', href: '/gl/blog/' },
  { label: post.data.title, href: canonical },
];
---

<BlogLayout
  title={`${post.data.title} | Zentro Limpiezas`}
  description={post.data.description}
  {canonical}
  lang="gl"
  datePublished={post.data.datePublished}
  dateModified={post.data.dateModified}
  image={post.data.image}
  category={post.data.category}
  {breadcrumbs}
  hreflangEs={hreflangEs}
  hreflangGl={canonical}
  faqs={post.data.faqs}
  {headings}
  {relatedPosts}
>
  <Content />
</BlogLayout>
