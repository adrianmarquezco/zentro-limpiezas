---
import ComboLayout from '@/layouts/ComboLayout.astro';
import HeroLocal from '@/components/sections/HeroLocal.astro';
import EcoBadge from '@/components/ui/EcoBadge.astro';
import ContactStrip from '@/components/sections/ContactStrip.astro';
import { SERVICIOS } from '@/data/servicios';
import { MUNICIPIOS } from '@/data/municipios';
import { getContenidoBarrio } from '@/data/combos-barrio';
import { BUSINESS, buildWhatsAppUrl, WA_MESSAGES } from '@/data/config';
import type { BarrioArchetype } from '@/data/municipios';

export function getStaticPaths() {
  const servicio = SERVICIOS.find(s => s.slug === 'limpieza-de-trasteros')!;
  const paths: { params: { municipio: string; barrio: string }; props: any }[] = [];
  for (const municipio of MUNICIPIOS) {
    if (municipio.comarca !== 'Ferrolterra') continue;
    if (!municipio.barrios) continue;
    for (const barrio of municipio.barrios) {
      if (!barrio.archetype) continue;
      const contenido = getContenidoBarrio('limpieza-de-trasteros', barrio.archetype as BarrioArchetype, barrio.nombre, municipio.nombre);
      if (!contenido) continue;
      paths.push({
        params: { municipio: municipio.slug, barrio: barrio.slug },
        props: { servicio, municipio, barrio, contenido },
      });
    }
  }
  return paths;
}

const { servicio, municipio, barrio, contenido } = Astro.props;

const canonical = `${BUSINESS.url}/servicios/limpieza-de-trasteros/${municipio.slug}/${barrio.slug}/`;
const hreflangEs = canonical;
const hreflangGl = `${BUSINESS.url}/gl/servizos/${servicio.slugGL}/${municipio.slug}/${barrio.slug}/`;
const ogImage = `${BUSINESS.url}/images/hero-equipo.webp`;

const title = `${contenido.tituloPagina} | Zentro Limpiezas`;
const description = `Limpieza de trastero en ${barrio.nombre}. ${contenido.metaDescAngle}`.slice(0, 160);

const breadcrumbs = [
  { label: 'Servicios', href: '/servicios/' },
  { label: servicio.nombre, href: `/servicios/${servicio.slug}/` },
  { label: municipio.nombre, href: `/servicios/${servicio.slug}/${municipio.slug}/` },
  { label: barrio.nombre, href: canonical },
];

const faqsLocales: { q: string; a: string }[] = [
  {
    q: `¿Cuánto cuesta limpiar un trastero en ${barrio.nombre}?`,
    a: `Para un trastero de hasta 10 m² en ${barrio.nombre}, desde 45€. Hasta 20 m², desde 70€. Para trasteros más grandes o con polvo de años muy acumulado, desde 90€. Presupuesto cerrado sin visita previa en 24h.`,
  },
  {
    q: `¿Movéis los objetos guardados en el trastero de ${barrio.nombre} para limpiar?`,
    a: `No, salvo que el cliente lo solicite. Limpiamos el suelo y las paredes accesibles trabajando alrededor de los objetos. Si hay zonas que el cliente quiere vaciar, lo coordinamos antes de la visita.`,
  },
  {
    q: `¿Tratáis el moho en las paredes del trastero de ${barrio.nombre}?`,
    a: `Sí. Aplicamos antifúngico ecológico en las paredes con manchas de moho superficial. Si el moho tiene origen en filtración estructural, avisamos al cliente para que lo evalúe con un técnico. La limpieza elimina el moho visible; el origen estructural requiere intervención aparte.`,
  },
];
const faqs = [...faqsLocales, ...contenido.faqs];

const waUrl = buildWhatsAppUrl(WA_MESSAGES.combo(servicio.nombre, barrio.nombre));

const otrosBarrios = (municipio.barrios ?? []).filter(
  b => b.slug !== barrio.slug && b.archetype && getContenidoBarrio('limpieza-de-trasteros', b.archetype as BarrioArchetype, '', ''),
);

const serviciosRelacionados = [
  { nombre: 'Limpieza de garajes', slug: 'limpieza-de-garajes' },
  { nombre: 'Limpieza de viviendas', slug: 'limpieza-de-viviendas' },
  { nombre: 'Limpieza a fondo', slug: 'limpieza-a-fondo' },
];

const h1 = `Limpieza de trastero en ${barrio.nombre}`;
---

<ComboLayout
  {title}
  {description}
  {canonical}
  {ogImage}
  lang="es"
  serviceName={`Limpieza de trasteros en ${barrio.nombre}, ${municipio.nombre}`}
  serviceDesc={description}
  price="45"
  {faqs}
  {breadcrumbs}
  {hreflangEs}
  hreflangGl={hreflangGl}
  areaServed={[barrio.nombre, municipio.nombre, municipio.comarca]}
>
  <HeroLocal
    municipio={barrio.nombre}
    servicio={servicio.nombre}
    eyebrow={`${servicio.nombre} · ${barrio.nombre}, ${municipio.nombre}`}
    {h1}
    qualifier={contenido.h1Qualifier}
    subtitle={contenido.speakableIntro}
    lang="es"
  />

  <section class="py-16 lg:py-24 bg-warm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <div class="lg:col-span-2 space-y-10">

          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">01</span>
              <h2 class="font-serif text-2xl lg:text-3xl text-primary">{contenido.problemaH2}</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>{contenido.problemaContent}</p>
              <p>{barrio.descripcion}</p>
            </div>
          </div>

          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">02</span>
              <h2 class="font-serif text-2xl text-primary">{contenido.ventanasH2}</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>{contenido.ventanasContent}</p>
            </div>
          </div>

          <figure data-reveal class="rounded-xl overflow-hidden border border-line">
            <img
              src="/images/hero-equipo.webp"
              alt={`Limpieza de trastero en ${barrio.nombre}, ${municipio.nombre} — Zentro Limpiezas`}
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
              class="w-full object-cover"
            />
            <figcaption class="text-xs text-mid text-center py-2 px-4">
              Limpieza de trasteros en {barrio.nombre} · Zentro Limpiezas
            </figcaption>
          </figure>

          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">03</span>
              <h2 class="font-serif text-2xl text-primary">¿Cuánto cuesta limpiar un trastero en {barrio.nombre}?</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <ul class="space-y-2 ml-4">
                <li class="flex items-start gap-2"><span class="text-accent font-bold mt-0.5">·</span><span>Trastero pequeño hasta 10 m²: desde 45€</span></li>
                <li class="flex items-start gap-2"><span class="text-accent font-bold mt-0.5">·</span><span>Trastero mediano hasta 20 m²: desde 70€</span></li>
                <li class="flex items-start gap-2"><span class="text-accent font-bold mt-0.5">·</span><span>Trastero grande o bajera rural: desde 90€</span></li>
                <li class="flex items-start gap-2"><span class="text-accent font-bold mt-0.5">·</span><span>Con tratamiento antifúngico de paredes incluido en el precio</span></li>
              </ul>
              <div class="p-4 bg-white border border-line rounded-lg">
                <p class="text-sm text-charcoal">
                  <span class="font-semibold text-primary">Sin mover tus objetos sin permiso.</span>{' '}
                  Limpiamos alrededor de lo guardado. Si quieres que reorganicemos algo, lo coordinamos antes de la visita.
                </p>
              </div>
            </div>
          </div>

          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">04</span>
              <h2 class="font-serif text-2xl text-primary">¿Por qué Zentro Limpiezas para el trastero de {barrio.nombre}?</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>
                Los trasteros son el espacio que más tiempo pasa sin atención, y el que más lo acusa. El polvo sedimentado, el moho de las paredes húmedas y las telarañas requieren aspirado industrial, antifúngico ecológico y la técnica correcta para no extender la suciedad en vez de eliminarla.
              </p>
              <p>
                Trabajamos en trasteros de toda Ferrolterra: sótanos de bloque, bajeras históricas de piedra, almacenes de chalé y cobertizos rurales. Cada tipo tiene sus particularidades y sabemos cómo tratarlos. Más de 20 años de experiencia en el entorno de {municipio.nombre}.
              </p>
              <div class="grid sm:grid-cols-3 gap-3 mt-4">
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">+20</p>
                  <p class="text-mid text-xs mt-1">años limpiando en Ferrolterra</p>
                </div>
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">24h</p>
                  <p class="text-mid text-xs mt-1">presupuesto sin visita previa</p>
                </div>
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">100%</p>
                  <p class="text-mid text-xs mt-1">productos Ecolabel certificados</p>
                </div>
              </div>
            </div>
          </div>

        </div>

        <aside class="space-y-6 self-start">

          <div class="card p-6 border-accent/30 sticky top-24 z-10" data-reveal>
            <p class="font-serif text-lg text-primary mb-2 font-semibold">Trastero en {barrio.nombre}</p>
            <p class="text-mid text-xs mb-4">Presupuesto gratis · Sin compromiso · 24h</p>
            <div class="flex flex-col gap-2">
              <a href="/presupuesto/" class="btn-accent w-full text-center text-sm">→ Pedir presupuesto</a>
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full justify-center text-sm">
                WhatsApp {BUSINESS.phoneDisplay}
              </a>
            </div>
            <div class="mt-4 pt-4 border-t border-line">
              <EcoBadge size="sm" />
            </div>
          </div>

          <div class="card p-6" data-reveal>
            <p class="font-serif text-base text-primary mb-1 font-semibold">Trasteros en todo {municipio.nombre}</p>
            <p class="text-mid text-xs mb-3">Precios y cobertura para todos los barrios.</p>
            <a href={`/servicios/limpieza-de-trasteros/${municipio.slug}/`} class="text-sm text-accent hover:underline">
              → Trasteros en {municipio.nombre}
            </a>
          </div>

          <div class="card p-6" data-reveal>
            <p class="font-serif text-base text-primary mb-3 font-semibold">Otros servicios en {barrio.nombre}</p>
            <ul class="space-y-2">
              {serviciosRelacionados.map(s => (
                <li>
                  <a href={`/servicios/${s.slug}/${municipio.slug}/${barrio.slug}/`} class="text-sm text-mid hover:text-primary hover:underline transition-colors">
                    → {s.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {otrosBarrios.length > 0 && (
            <div class="card p-6" data-reveal>
              <p class="font-serif text-base text-primary mb-3 font-semibold">Trasteros en otros barrios de {municipio.nombre}</p>
              <ul class="space-y-2">
                {otrosBarrios.slice(0, 6).map(b => (
                  <li>
                    <a href={`/servicios/limpieza-de-trasteros/${municipio.slug}/${b.slug}/`} class="text-sm text-mid hover:text-primary hover:underline transition-colors">
                      → {b.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="card p-4" data-reveal>
            <a href={`/zonas/${municipio.slug}/${barrio.slug}/`} class="text-xs text-mid hover:text-accent hover:underline transition-colors">
              → Todos los servicios disponibles en {barrio.nombre}
            </a>
          </div>

        </aside>
      </div>
    </div>
  </section>

  <section class="py-16 bg-charcoal">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-2xl lg:text-3xl text-warm mb-3 text-center" data-reveal>
        Preguntas sobre limpieza de trasteros en {barrio.nombre}
      </h2>
      <p class="text-white/60 text-center mb-8" data-reveal>
        Llámanos al <a href={BUSINESS.phoneHref} class="text-accent hover:underline">{BUSINESS.phoneDisplay}</a> o escríbenos por WhatsApp.
      </p>
      <div class="space-y-3" data-reveal>
        {faqs.map((faq) => (
          <details class="bg-charcoal border border-white/10 rounded-lg group">
            <summary class="flex items-center justify-between gap-3 p-5 cursor-pointer list-none hover:text-white transition-colors">
              <h3 class="text-white/90 font-medium text-sm m-0 group-open:text-white">{faq.q}</h3>
              <span class="text-accent flex-shrink-0 text-lg group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="px-5 pb-5 text-white/70 text-sm leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactStrip context={`${barrio.nombre}, ${municipio.nombre}`} />
</ComboLayout>
