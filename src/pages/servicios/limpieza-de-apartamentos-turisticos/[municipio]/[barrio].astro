---
import ComboLayout from '@/layouts/ComboLayout.astro';
import HeroLocal from '@/components/sections/HeroLocal.astro';
import EcoBadge from '@/components/ui/EcoBadge.astro';
import ContactStrip from '@/components/sections/ContactStrip.astro';
import { SERVICIOS } from '@/data/servicios';
import { MUNICIPIOS } from '@/data/municipios';
import { getContenidoTuristicos } from '@/data/combos-barrio';
import { BUSINESS, buildWhatsAppUrl, WA_MESSAGES } from '@/data/config';
import type { BarrioArchetype } from '@/data/municipios';

export function getStaticPaths() {
  const servicio = SERVICIOS.find(s => s.slug === 'limpieza-de-apartamentos-turisticos')!;
  const paths: { params: { municipio: string; barrio: string }; props: any }[] = [];
  for (const municipio of MUNICIPIOS) {
    if (municipio.comarca !== 'Ferrolterra') continue;
    if (!municipio.barrios) continue;
    for (const barrio of municipio.barrios) {
      if (!barrio.archetype) continue;
      const contenido = getContenidoTuristicos(barrio.archetype as BarrioArchetype, barrio.nombre, municipio.nombre);
      if (!contenido) continue;
      paths.push({
        params: { municipio: municipio.slug, barrio: barrio.slug },
        props: { servicio, municipio, barrio, contenido },
      });
    }
  }
  return paths;
}

const { servicio, municipio, barrio, contenido } = Astro.props;

const canonical = `${BUSINESS.url}/servicios/limpieza-de-apartamentos-turisticos/${municipio.slug}/${barrio.slug}/`;
const hreflangEs = canonical;

const title = `Limpieza de apartamento turístico en ${barrio.nombre}, ${municipio.nombre} | Zentro Limpiezas`;
const description = contenido.metaDesc;

const breadcrumbs = [
  { label: 'Servicios', href: '/servicios/' },
  { label: servicio.nombre, href: `/servicios/${servicio.slug}/` },
  { label: municipio.nombre, href: `/servicios/${servicio.slug}/${municipio.slug}/` },
  { label: barrio.nombre, href: canonical },
];

const faqsLocales: { q: string; a: string }[] = [
  {
    q: `¿Cuánto cuesta el cambio de huésped en un apartamento de ${barrio.nombre}?`,
    a: `En ${barrio.nombre} el cambio de huésped empieza desde 60€ para un estudio o apartamento de 1 habitación. El precio depende de los metros y el número de baños. Presupuesto cerrado en menos de 24h.`,
  },
  {
    q: `¿Podéis gestionar los cambios de huésped en ${barrio.nombre} sin que yo esté presente?`,
    a: `Sí. Guardamos tu llave o usamos tu código de cerradura. Coordinamos por WhatsApp, hacemos el cambio y te enviamos foto de confirmación de cada estancia al terminar. Si encontramos alguna incidencia, te avisamos antes de seguir.`,
  },
];
const faqs = [...faqsLocales, ...contenido.faqs];

const waUrl = buildWhatsAppUrl(WA_MESSAGES.combo(servicio.nombre, barrio.nombre));

const otrosBarrios = (municipio.barrios ?? []).filter(
  b => b.slug !== barrio.slug && b.archetype && getContenidoTuristicos(b.archetype as BarrioArchetype, '', ''),
);

const h1 = `Limpieza de apartamento turístico en ${barrio.nombre}<br><span class="text-accent">${contenido.h1Qualifier}</span>`;
---

<ComboLayout
  {title}
  {description}
  {canonical}
  lang="es"
  serviceName={`${servicio.nombre} en ${barrio.nombre}, ${municipio.nombre}`}
  serviceDesc={description}
  {faqs}
  {breadcrumbs}
  {hreflangEs}
  areaServed={[barrio.nombre, municipio.nombre, municipio.comarca]}
>
  <HeroLocal
    municipio={barrio.nombre}
    servicio={servicio.nombre}
    eyebrow={`${servicio.nombre} · ${barrio.nombre}, ${municipio.nombre}`}
    {h1}
    subtitle={contenido.intro}
    lang="es"
  />

  <section class="py-16 lg:py-24 bg-warm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <div class="lg:col-span-2 space-y-10">

          <!-- El reto de la rotación en este barrio -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">01</span>
              <h2 class="font-serif text-2xl lg:text-3xl text-primary">{contenido.rotacionH2}</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>{contenido.rotacionContent}</p>
            </div>
          </div>

          <!-- Protocolo paso a paso -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">02</span>
              <h2 class="font-serif text-2xl text-primary">{contenido.protocoloH2}</h2>
            </div>
            <ol class="space-y-3">
              {contenido.protocoloItems.map((item, i) => (
                <li class="flex items-start gap-4">
                  <span class="flex-shrink-0 w-7 h-7 rounded-full bg-accent/10 border border-accent/30 text-accent text-xs font-bold flex items-center justify-center mt-0.5">
                    {i + 1}
                  </span>
                  <span class="text-mid text-sm leading-relaxed pt-1">{item}</span>
                </li>
              ))}
            </ol>
            <p class="text-mid text-sm mt-5 leading-relaxed">
              Todos los productos son Ecolabel certificados. Sin olor a producto químico cuando llegan tus huéspedes.
            </p>
          </div>

          <!-- Precio por rotación -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">03</span>
              <h2 class="font-serif text-2xl text-primary">Precio del cambio de huésped en {barrio.nombre}</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <ul class="space-y-2 ml-4">
                {contenido.precioItems.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="text-accent font-bold mt-0.5">·</span>
                    <span set:html={item.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
                  </li>
                ))}
              </ul>
              <div class="p-4 bg-white border border-line rounded-lg">
                <p class="text-sm text-charcoal">
                  <span class="font-semibold text-primary">¿Tienes más de un apartamento turístico en {barrio.nombre}?</span>{' '}
                  Gestionamos varios apartamentos del mismo propietario con tarifa preferente por volumen. Cuéntanos cuántos son al pedir presupuesto.
                </p>
              </div>
            </div>
          </div>

        </div>

        <!-- Aside -->
        <aside class="space-y-6 self-start">

          <div class="card p-6 border-accent/30 sticky top-24" data-reveal>
            <p class="font-serif text-lg text-primary mb-2 font-semibold">Cambios de huésped en {barrio.nombre}</p>
            <p class="text-mid text-xs mb-4">Presupuesto gratis · Sin compromiso · 24h</p>
            <div class="flex flex-col gap-2">
              <a href="/presupuesto/" class="btn-accent w-full text-center text-sm">→ Pedir presupuesto</a>
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full justify-center text-sm">
                WhatsApp {BUSINESS.phoneDisplay}
              </a>
            </div>
            <div class="mt-4 pt-4 border-t border-line">
              <EcoBadge size="sm" />
            </div>
          </div>

          <div class="card p-6" data-reveal>
            <p class="font-serif text-base text-primary mb-1 font-semibold">Apartamentos turísticos en todo {municipio.nombre}</p>
            <p class="text-mid text-xs mb-3">Cobertura completa para gestores de alquiler vacacional.</p>
            <a href={`/servicios/limpieza-de-apartamentos-turisticos/${municipio.slug}/`} class="text-sm text-accent hover:underline">
              → Limpieza turística en {municipio.nombre}
            </a>
          </div>

          {otrosBarrios.length > 0 && (
            <div class="card p-6" data-reveal>
              <p class="font-serif text-base text-primary mb-3 font-semibold">Cambios de huésped en otros barrios de {municipio.nombre}</p>
              <ul class="space-y-2">
                {otrosBarrios.slice(0, 7).map(b => (
                  <li>
                    <a href={`/servicios/limpieza-de-apartamentos-turisticos/${municipio.slug}/${b.slug}/`} class="text-sm text-mid hover:text-primary hover:underline transition-colors">
                      → {b.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="card p-4" data-reveal>
            <a href={`/zonas/${municipio.slug}/${barrio.slug}/`} class="text-xs text-mid hover:text-accent hover:underline transition-colors">
              → Todos los servicios disponibles en {barrio.nombre}
            </a>
          </div>

        </aside>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-charcoal">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-2xl lg:text-3xl text-warm mb-3 text-center" data-reveal>
        Preguntas sobre limpieza de apartamentos turísticos en {barrio.nombre}
      </h2>
      <p class="text-white/60 text-center mb-8" data-reveal>
        Llámanos al <a href={BUSINESS.phoneHref} class="text-accent hover:underline">{BUSINESS.phoneDisplay}</a> o escríbenos por WhatsApp.
      </p>
      <div class="space-y-3" data-reveal>
        {faqs.map((faq) => (
          <details class="bg-charcoal border border-white/10 rounded-lg group">
            <summary class="flex items-center justify-between gap-3 p-5 cursor-pointer list-none hover:text-white transition-colors">
              <h3 class="text-white/90 font-medium text-sm m-0 group-open:text-white">{faq.q}</h3>
              <span class="text-accent flex-shrink-0 text-lg group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="px-5 pb-5 text-white/70 text-sm leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactStrip context={`${barrio.nombre}, ${municipio.nombre}`} />
</ComboLayout>
