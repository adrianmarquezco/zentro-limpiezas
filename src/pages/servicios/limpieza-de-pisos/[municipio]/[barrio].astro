---
import ComboLayout from '@/layouts/ComboLayout.astro';
import HeroLocal from '@/components/sections/HeroLocal.astro';
import EcoBadge from '@/components/ui/EcoBadge.astro';
import ContactStrip from '@/components/sections/ContactStrip.astro';
import { SERVICIOS } from '@/data/servicios';
import { MUNICIPIOS } from '@/data/municipios';
import { getContenidoPisos } from '@/data/combos-barrio';
import { BUSINESS, buildWhatsAppUrl, WA_MESSAGES } from '@/data/config';
import type { BarrioArchetype } from '@/data/municipios';

export function getStaticPaths() {
  const servicio = SERVICIOS.find(s => s.slug === 'limpieza-de-pisos')!;
  const paths: { params: { municipio: string; barrio: string }; props: any }[] = [];
  for (const municipio of MUNICIPIOS) {
    if (municipio.comarca !== 'Ferrolterra') continue;
    if (!municipio.barrios) continue;
    for (const barrio of municipio.barrios) {
      if (!barrio.archetype) continue;
      const contenido = getContenidoPisos(barrio.archetype as BarrioArchetype, barrio.nombre, municipio.nombre);
      if (!contenido) continue;
      paths.push({
        params: { municipio: municipio.slug, barrio: barrio.slug },
        props: { servicio, municipio, barrio, contenido },
      });
    }
  }
  return paths;
}

const { servicio, municipio, barrio, contenido } = Astro.props;

const canonical = `${BUSINESS.url}/servicios/limpieza-de-pisos/${municipio.slug}/${barrio.slug}/`;
const hreflangEs = canonical;
const hreflangGl = `${BUSINESS.url}/gl/servizos/${servicio.slugGL}/${municipio.slug}/${barrio.slug}/`;
const ogImage = `${BUSINESS.url}/images/blog/como-limpiar-el-piso-a-fondo.webp`;

const title = `Limpieza de Piso en ${barrio.nombre}, ${municipio.nombre} · Presupuesto Gratis 24h | Zentro Limpiezas`;
const description = `Limpieza profesional de pisos en ${barrio.nombre}. ${contenido.metaDesc} Limpiadoras con experiencia. Presupuesto gratis en 24h, sin visita previa.`.slice(0, 160);

const breadcrumbs = [
  { label: 'Servicios', href: '/servicios/' },
  { label: servicio.nombre, href: `/servicios/${servicio.slug}/` },
  { label: municipio.nombre, href: `/servicios/${servicio.slug}/${municipio.slug}/` },
  { label: barrio.nombre, href: canonical },
];

const faqsLocales: { q: string; a: string }[] = [
  {
    q: `¿Cuánto cuesta limpiar un piso en ${barrio.nombre}?`,
    a: `En ${barrio.nombre} la limpieza de un piso de 2 habitaciones empieza desde 130€. Para pisos de 3 habitaciones, desde 170€. El precio exacto depende de los metros cuadrados y el estado. Presupuesto cerrado en menos de 24h sin necesidad de visita previa.`,
  },
  {
    q: `¿Cuánto tiempo tardáis en limpiar un piso en ${barrio.nombre}?`,
    a: `Para un piso estándar de 70 m² en ${barrio.nombre}, entre 3 y 4 horas con dos personas. Si lleva tiempo sin limpieza a fondo o necesitas interior de armarios, puede extenderse. Lo indicamos siempre en el presupuesto antes de empezar.`,
  },
  {
    q: `¿Limpiáis el interior del horno y la nevera en el servicio de limpieza de pisos de ${barrio.nombre}?`,
    a: `Sí, a petición. El interior del horno y la nevera están incluidos sin suplemento si lo pides al presupuestar. El horno con grasa muy incrustada puede necesitar tiempo adicional que reflejamos en el presupuesto.`,
  },
  {
    q: `¿Podéis limpiar el piso de ${barrio.nombre} con llave mientras yo trabajo?`,
    a: `Sí. Guardamos tu llave o código de acceso. Entramos, limpiamos y enviamos foto de confirmación de cada habitación al terminar. Es la opción que prefieren la mayoría de nuestros clientes en ${barrio.nombre}.`,
  },
];
const faqs = [...faqsLocales, ...contenido.faqs];

const waUrl = buildWhatsAppUrl(WA_MESSAGES.combo(servicio.nombre, barrio.nombre));

const otrosBarrios = (municipio.barrios ?? []).filter(
  b => b.slug !== barrio.slug && b.archetype && getContenidoPisos(b.archetype as BarrioArchetype, '', ''),
);

const serviciosRelacionados = [
  { nombre: 'Limpieza periódica del hogar', slug: 'limpieza-periodica' },
  { nombre: 'Limpieza de viviendas', slug: 'limpieza-de-viviendas' },
  { nombre: 'Limpieza de cristales', slug: 'limpieza-de-cristales' },
];

const h1 = `Limpieza de piso en ${barrio.nombre}<br><span class="text-accent">${contenido.h1Qualifier}</span>`;
---

<ComboLayout
  {title}
  {description}
  {canonical}
  {ogImage}
  lang="es"
  serviceName={`Limpieza de piso en ${barrio.nombre}, ${municipio.nombre}`}
  serviceDesc={description}
  price="100"
  {faqs}
  {breadcrumbs}
  {hreflangEs}
  hreflangGl={hreflangGl}
  areaServed={[barrio.nombre, municipio.nombre, municipio.comarca]}
>
  <HeroLocal
    municipio={barrio.nombre}
    servicio={servicio.nombre}
    eyebrow={`${servicio.nombre} · ${barrio.nombre}, ${municipio.nombre}`}
    {h1}
    subtitle={contenido.intro}
    lang="es"
  />

  <section class="py-16 lg:py-24 bg-warm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <div class="lg:col-span-2 space-y-10">

          <!-- 01 · Contexto específico del barrio -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">01</span>
              <h2 class="font-serif text-2xl lg:text-3xl text-primary">{contenido.contextoH2}</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>{contenido.contextoContent}</p>
            </div>
          </div>

          <!-- 02 · Qué incluye la limpieza del piso -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">02</span>
              <h2 class="font-serif text-2xl text-primary">{contenido.incluyeH2}</h2>
            </div>
            <ul class="space-y-0 divide-y divide-line">
              {contenido.incluyeItems.map(item => (
                <li class="flex items-start gap-3 py-3">
                  <span class="text-accent font-bold flex-shrink-0 mt-0.5">→</span>
                  <span class="text-mid text-sm leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
            <p class="text-mid text-sm mt-5 leading-relaxed">
              Llevamos todos los productos Ecolabel y el material necesario. No tienes que preparar nada antes de la visita.
            </p>
          </div>

          <!-- Imagen optimizada -->
          <figure data-reveal class="rounded-xl overflow-hidden border border-line">
            <img
              src="/images/blog/como-limpiar-el-piso-a-fondo.webp"
              alt={`Limpiadoras profesionales limpiando un piso en ${barrio.nombre}, ${municipio.nombre} — Zentro Limpiezas`}
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
              class="w-full object-cover"
            />
            <figcaption class="text-xs text-mid text-center py-2 px-4">
              Limpieza a fondo de piso en {barrio.nombre} · Zentro Limpiezas
            </figcaption>
          </figure>

          <!-- 03 · Precio -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">03</span>
              <h2 class="font-serif text-2xl text-primary">¿Cuánto cuesta limpiar un piso en {barrio.nombre}?</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>Precio orientativo para pisos en {barrio.nombre} según el tamaño:</p>
              <ul class="space-y-2 ml-4">
                {contenido.precioItems.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="text-accent font-bold mt-0.5">·</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="p-4 bg-white border border-line rounded-lg">
                <p class="text-sm text-charcoal">
                  <span class="font-semibold text-primary">¿Tienes varios pisos en {barrio.nombre}?</span>{' '}
                  Propietarios con varios pisos de alquiler o comunidades de vecinos tienen condiciones especiales. Cuéntanos cuántos son al pedir presupuesto.
                </p>
              </div>
            </div>
          </div>

          <!-- 04 · Por qué elegirnos (trust + LSI) -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">04</span>
              <h2 class="font-serif text-2xl text-primary">¿Por qué Zentro Limpiezas para la limpieza de tu piso en {barrio.nombre}?</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>
                Zentro Limpiezas es la empresa de limpieza de pisos de referencia en {barrio.nombre} y en todo {municipio.nombre}. Más de 20 años limpiando hogares en Ferrolterra avalan nuestro trabajo. Equipo propio, sin subcontrataciones, con las mismas limpiadoras en cada visita para que conozcan tu piso.
              </p>
              <p>
                Tanto si necesitas la limpieza del piso después de una mudanza, antes de entregarlo al propietario, como limpieza a fondo puntual o limpieza periódica regular: lo organizamos todo para que tú no tengas que preocuparte. Presupuesto cerrado sin visita previa y respuesta en menos de 24 horas.
              </p>
              <div class="grid sm:grid-cols-3 gap-3 mt-4">
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">+20</p>
                  <p class="text-mid text-xs mt-1">años en Ferrolterra</p>
                </div>
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">24h</p>
                  <p class="text-mid text-xs mt-1">presupuesto sin visita previa</p>
                </div>
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">100%</p>
                  <p class="text-mid text-xs mt-1">equipo propio sin subcontratas</p>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Aside -->
        <aside class="space-y-6 self-start">

          <div class="card p-6 border-accent/30 sticky top-24" data-reveal>
            <p class="font-serif text-lg text-primary mb-2 font-semibold">Limpieza de piso en {barrio.nombre}</p>
            <p class="text-mid text-xs mb-4">Presupuesto gratis · Sin compromiso · 24h</p>
            <div class="flex flex-col gap-2">
              <a href="/presupuesto/" class="btn-accent w-full text-center text-sm">→ Pedir presupuesto</a>
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full justify-center text-sm">
                WhatsApp {BUSINESS.phoneDisplay}
              </a>
            </div>
            <div class="mt-4 pt-4 border-t border-line">
              <EcoBadge size="sm" />
            </div>
          </div>

          <div class="card p-6" data-reveal>
            <p class="font-serif text-base text-primary mb-1 font-semibold">Limpieza de pisos en todo {municipio.nombre}</p>
            <p class="text-mid text-xs mb-3">Cobertura completa y precios para el municipio.</p>
            <a href={`/servicios/limpieza-de-pisos/${municipio.slug}/`} class="text-sm text-accent hover:underline">
              → Limpieza de pisos en {municipio.nombre}
            </a>
          </div>

          <div class="card p-6" data-reveal>
            <p class="font-serif text-base text-primary mb-3 font-semibold">Otros servicios en {barrio.nombre}</p>
            <ul class="space-y-2">
              {serviciosRelacionados.map(s => (
                <li>
                  <a href={`/servicios/${s.slug}/${municipio.slug}/${barrio.slug}/`} class="text-sm text-mid hover:text-primary hover:underline transition-colors">
                    → {s.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {otrosBarrios.length > 0 && (
            <div class="card p-6" data-reveal>
              <p class="font-serif text-base text-primary mb-3 font-semibold">Limpieza de pisos en otros barrios de {municipio.nombre}</p>
              <ul class="space-y-2">
                {otrosBarrios.slice(0, 6).map(b => (
                  <li>
                    <a href={`/servicios/limpieza-de-pisos/${municipio.slug}/${b.slug}/`} class="text-sm text-mid hover:text-primary hover:underline transition-colors">
                      → {b.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="card p-4" data-reveal>
            <a href={`/zonas/${municipio.slug}/${barrio.slug}/`} class="text-xs text-mid hover:text-accent hover:underline transition-colors">
              → Todos los servicios disponibles en {barrio.nombre}
            </a>
          </div>

        </aside>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-charcoal">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-2xl lg:text-3xl text-warm mb-3 text-center" data-reveal>
        Preguntas frecuentes sobre limpieza de pisos en {barrio.nombre}
      </h2>
      <p class="text-white/60 text-center mb-8" data-reveal>
        Llámanos al <a href={BUSINESS.phoneHref} class="text-accent hover:underline">{BUSINESS.phoneDisplay}</a> o escríbenos por WhatsApp.
      </p>
      <div class="space-y-3" data-reveal>
        {faqs.map((faq) => (
          <details class="bg-charcoal border border-white/10 rounded-lg group">
            <summary class="flex items-center justify-between gap-3 p-5 cursor-pointer list-none hover:text-white transition-colors">
              <h3 class="text-white/90 font-medium text-sm m-0 group-open:text-white">{faq.q}</h3>
              <span class="text-accent flex-shrink-0 text-lg group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="px-5 pb-5 text-white/70 text-sm leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactStrip context={`${barrio.nombre}, ${municipio.nombre}`} />
</ComboLayout>
