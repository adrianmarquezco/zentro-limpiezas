---
import ComboLayout from '@/layouts/ComboLayout.astro';
import HeroLocal from '@/components/sections/HeroLocal.astro';
import EcoBadge from '@/components/ui/EcoBadge.astro';
import ContactStrip from '@/components/sections/ContactStrip.astro';
import { SERVICIOS } from '@/data/servicios';
import { MUNICIPIOS } from '@/data/municipios';
import { getContenidoViviendas } from '@/data/combos-barrio';
import { BUSINESS, buildWhatsAppUrl, WA_MESSAGES, buildMetaDescription } from '@/data/config';
import type { BarrioArchetype } from '@/data/municipios';

export function getStaticPaths() {
  const servicio = SERVICIOS.find(s => s.slug === 'limpieza-de-viviendas')!;
  const paths: { params: { municipio: string; barrio: string }; props: any }[] = [];
  for (const municipio of MUNICIPIOS) {
    if (municipio.comarca !== 'Ferrolterra') continue;
    if (!municipio.barrios) continue;
    for (const barrio of municipio.barrios) {
      if (!barrio.archetype) continue;
      const contenido = getContenidoViviendas(barrio.archetype as BarrioArchetype, barrio.nombre, municipio.nombre);
      if (!contenido) continue;
      paths.push({
        params: { municipio: municipio.slug, barrio: barrio.slug },
        props: { servicio, municipio, barrio, contenido },
      });
    }
  }
  return paths;
}

const { servicio, municipio, barrio, contenido } = Astro.props;

const canonical = `${BUSINESS.url}/servicios/limpieza-de-viviendas/${municipio.slug}/${barrio.slug}/`;
const hreflangEs = canonical;
const hreflangGl = `${BUSINESS.url}/gl/servizos/${servicio.slugGL}/${municipio.slug}/${barrio.slug}/`;
const ogImage = `${BUSINESS.url}/images/hero-viviendas.webp`;

const title = `Limpieza de Vivienda en ${barrio.nombre}, ${municipio.nombre} | Zentro Limpiezas`;
const description = buildMetaDescription(`Limpieza profesional de viviendas en ${barrio.nombre}.`, contenido.metaDesc, 'Empresa de limpieza con 20 años en Ferrolterra. Presupuesto gratis en 24h.');

const breadcrumbs = [
  { label: 'Servicios', href: '/servicios/' },
  { label: servicio.nombre, href: `/servicios/${servicio.slug}/` },
  { label: municipio.nombre, href: `/servicios/${servicio.slug}/${municipio.slug}/` },
  { label: barrio.nombre, href: canonical },
];

const faqsLocales: { q: string; a: string }[] = [
  {
    q: `¿Cuánto cuesta la limpieza de una vivienda en ${barrio.nombre}?`,
    a: `En ${barrio.nombre}, la limpieza a fondo de una vivienda empieza desde 120€ para pisos de 1-2 habitaciones y desde 160€ para pisos de 3 habitaciones. El precio final depende de los metros cuadrados, el número de baños y el estado de la vivienda. Presupuesto cerrado en menos de 24h sin visita previa.`,
  },
  {
    q: `¿Cuánto tiempo tardáis en limpiar una vivienda en ${barrio.nombre}?`,
    a: `Para un piso de 70-80 m² en ${barrio.nombre}, entre 3 y 5 horas con un equipo de dos personas. En viviendas más grandes o con mucho tiempo sin limpieza a fondo puede extenderse a 6 horas. Lo especificamos siempre en el presupuesto.`,
  },
  {
    q: `¿Podéis hacer la limpieza de vivienda en ${barrio.nombre} mientras yo no estoy?`,
    a: `Sí. Guardamos una copia de tu llave o usamos tu código de acceso. Hacemos la limpieza y te enviamos foto de confirmación de cada estancia al terminar. Es la opción que prefieren la mayoría de nuestros clientes en ${barrio.nombre}.`,
  },
  {
    q: `¿Limpiáis también el interior de los armarios y los electrodomésticos en ${barrio.nombre}?`,
    a: `El interior de armarios y electrodomésticos (nevera, horno, microondas) se incluye a petición sin suplemento. Solo indícanoslo al pedir presupuesto para planificar el tiempo necesario.`,
  },
];
const faqs = [...faqsLocales, ...contenido.faqs];

const waUrl = buildWhatsAppUrl(WA_MESSAGES.combo(servicio.nombre, barrio.nombre));

const otrosBarrios = (municipio.barrios ?? []).filter(
  b => b.slug !== barrio.slug && b.archetype && getContenidoViviendas(b.archetype as BarrioArchetype, '', ''),
);

const serviciosRelacionados = [
  { nombre: 'Limpieza periódica del hogar', slug: 'limpieza-periodica' },
  { nombre: 'Limpieza de pisos', slug: 'limpieza-de-pisos' },
  { nombre: 'Limpieza de cristales', slug: 'limpieza-de-cristales' },
];

const h1 = `Limpieza de vivienda en ${barrio.nombre}`;
---

<ComboLayout
  {title}
  {description}
  {canonical}
  {ogImage}
  lang="es"
  serviceName={`Limpieza de vivienda en ${barrio.nombre}, ${municipio.nombre}`}
  serviceDesc={description}
  price="120"
  {faqs}
  {breadcrumbs}
  {hreflangEs}
  hreflangGl={hreflangGl}
  areaServed={[barrio.nombre, municipio.nombre, municipio.comarca]}
>
  <HeroLocal
    municipio={barrio.nombre}
    servicio={servicio.nombre}
    eyebrow={`${servicio.nombre} · ${barrio.nombre}, ${municipio.nombre}`}
    {h1}
    qualifier={contenido.h1Qualifier}
    subtitle={contenido.intro}
    lang="es"
  />

  <section class="py-16 lg:py-24 bg-warm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <div class="lg:col-span-2 space-y-10">

          <!-- 01 · Particularidades de la vivienda en este barrio -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">01</span>
              <h2 class="font-serif text-2xl lg:text-3xl text-primary">{contenido.particularH2}</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>{contenido.particularContent}</p>
              <p>{barrio.descripcion}</p>
            </div>
          </div>

          <!-- 02 · Qué incluye la limpieza completa -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">02</span>
              <h2 class="font-serif text-2xl text-primary">{contenido.habitacionesH2}</h2>
            </div>
            <div class="grid sm:grid-cols-2 gap-3">
              {contenido.habitacionesItems.map(item => (
                <div class="flex items-start gap-3 p-3 bg-white border border-line rounded-lg">
                  <span class="text-accent font-bold text-base leading-tight mt-0.5 flex-shrink-0">✓</span>
                  <span class="text-mid text-sm leading-relaxed">{item}</span>
                </div>
              ))}
            </div>
            <p class="text-mid text-sm mt-5 leading-relaxed">
              Traemos todos los productos: Ecolabel con certificación europea. Sin necesidad de que tengas nada preparado.
            </p>
          </div>

          <!-- Imagen optimizada -->
          <figure data-reveal class="rounded-xl overflow-hidden border border-line">
            <img
              src="/images/hero-viviendas.webp"
              alt={`Limpieza profesional de vivienda en ${barrio.nombre}, ${municipio.nombre} — Zentro Limpiezas`}
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
              class="w-full object-cover"
            />
            <figcaption class="text-xs text-mid text-center py-2 px-4">
              Limpieza de vivienda en {barrio.nombre} · Zentro Limpiezas
            </figcaption>
          </figure>

          <!-- 03 · Precio -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">03</span>
              <h2 class="font-serif text-2xl text-primary">¿Cuánto cuesta la limpieza de vivienda en {barrio.nombre}?</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>El precio de la limpieza de vivienda en {barrio.nombre} depende de los metros cuadrados, el número de baños y el estado inicial. Como orientación:</p>
              <ul class="space-y-2 ml-4">
                {contenido.precioItems.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="text-accent font-bold mt-0.5">·</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="p-4 bg-white border border-line rounded-lg">
                <p class="text-sm text-charcoal">
                  <span class="font-semibold text-primary">¿Combinas varios servicios?</span>{' '}
                  Muchos clientes en {barrio.nombre} piden limpieza de vivienda + limpieza de cristales en la misma visita. En la misma jornada sale más económico y no tienes que organizar dos visitas distintas.
                </p>
              </div>
            </div>
          </div>

          <!-- 04 · Por qué elegirnos (trust + LSI) -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">04</span>
              <h2 class="font-serif text-2xl text-primary">¿Por qué Zentro Limpiezas para la limpieza de tu vivienda en {barrio.nombre}?</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>
                Zentro Limpiezas ofrece servicios de limpieza profesional con más de 20 años de experiencia en {municipio.nombre} y toda Ferrolterra. Trabajamos con equipo propio, sin subcontrataciones. Para la limpieza de hogares en {barrio.nombre}, asignamos las mismas limpiadoras profesionales en cada visita para que conozcan tu vivienda y sus particularidades.
              </p>
              <p>
                Si buscas un servicio de limpieza del hogar serio, con presupuesto cerrado y sin sorpresas en la factura, somos la empresa de limpieza de {barrio.nombre} que necesitas. Respondemos en menos de 24 horas y podemos empezar en 48-72 horas desde que nos lo pides.
              </p>
              <div class="grid sm:grid-cols-3 gap-3 mt-4">
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">+20</p>
                  <p class="text-mid text-xs mt-1">años limpiando hogares</p>
                </div>
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">24h</p>
                  <p class="text-mid text-xs mt-1">presupuesto sin visita previa</p>
                </div>
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">Ecolabel</p>
                  <p class="text-mid text-xs mt-1">productos certificados siempre</p>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Aside -->
        <aside class="space-y-6 self-start">

          <div class="card p-6 border-accent/30">
            <p class="font-serif text-lg text-primary mb-2 font-semibold">Limpieza de vivienda en {barrio.nombre}</p>
            <p class="text-mid text-xs mb-4">Presupuesto gratis · Sin compromiso · 24h</p>
            <div class="flex flex-col gap-2">
              <a href="/presupuesto/" class="btn-accent w-full text-center text-sm">→ Pedir presupuesto</a>
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full justify-center text-sm">
                WhatsApp {BUSINESS.phoneDisplay}
              </a>
            </div>
            <div class="mt-4 pt-4 border-t border-line">
              <EcoBadge size="sm" />
            </div>
          </div>

          <div class="card p-6" data-reveal>
            <p class="font-serif text-base text-primary mb-1 font-semibold">Limpieza de viviendas en todo {municipio.nombre}</p>
            <p class="text-mid text-xs mb-3">Cobertura completa para el municipio.</p>
            <a href={`/servicios/limpieza-de-viviendas/${municipio.slug}/`} class="text-sm text-accent hover:underline">
              → Limpieza de viviendas en {municipio.nombre}
            </a>
          </div>

          <div class="card p-6" data-reveal>
            <p class="font-serif text-base text-primary mb-3 font-semibold">Otros servicios en {barrio.nombre}</p>
            <ul class="space-y-2">
              {serviciosRelacionados.map(s => (
                <li>
                  <a href={`/servicios/${s.slug}/${municipio.slug}/${barrio.slug}/`} class="text-sm text-mid hover:text-primary hover:underline transition-colors">
                    → {s.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {otrosBarrios.length > 0 && (
            <div class="card p-6" data-reveal>
              <p class="font-serif text-base text-primary mb-3 font-semibold">Limpieza de viviendas en otros barrios de {municipio.nombre}</p>
              <ul class="space-y-2">
                {otrosBarrios.slice(0, 6).map(b => (
                  <li>
                    <a href={`/servicios/limpieza-de-viviendas/${municipio.slug}/${b.slug}/`} class="text-sm text-mid hover:text-primary hover:underline transition-colors">
                      → {b.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="card p-4" data-reveal>
            <a href={`/zonas/${municipio.slug}/${barrio.slug}/`} class="text-xs text-mid hover:text-accent hover:underline transition-colors">
              → Todos los servicios disponibles en {barrio.nombre}
            </a>
          </div>

        </aside>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-charcoal">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-2xl lg:text-3xl text-warm mb-3 text-center" data-reveal>
        Preguntas frecuentes sobre limpieza de viviendas en {barrio.nombre}
      </h2>
      <p class="text-white/60 text-center mb-8" data-reveal>
        Llámanos al <a href={BUSINESS.phoneHref} class="text-accent hover:underline">{BUSINESS.phoneDisplay}</a> o escríbenos por WhatsApp.
      </p>
      <div class="space-y-3" data-reveal>
        {faqs.map((faq) => (
          <details class="bg-charcoal border border-white/10 rounded-lg group">
            <summary class="flex items-center justify-between gap-3 p-5 cursor-pointer list-none hover:text-white transition-colors">
              <h3 class="text-white/90 font-medium text-sm m-0 group-open:text-white">{faq.q}</h3>
              <span class="text-accent flex-shrink-0 text-lg group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="px-5 pb-5 text-white/70 text-sm leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactStrip context={`${barrio.nombre}, ${municipio.nombre}`} />
</ComboLayout>
