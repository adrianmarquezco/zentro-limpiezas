---
import ComboLayout from '@/layouts/ComboLayout.astro';
import HeroLocal from '@/components/sections/HeroLocal.astro';
import EcoBadge from '@/components/ui/EcoBadge.astro';
import ContactStrip from '@/components/sections/ContactStrip.astro';
import { SERVICIOS } from '@/data/servicios';
import { MUNICIPIOS } from '@/data/municipios';
import { getContenidoPeriodica } from '@/data/combos-barrio';
import { BUSINESS, buildWhatsAppUrl, WA_MESSAGES } from '@/data/config';
import type { BarrioArchetype } from '@/data/municipios';

export function getStaticPaths() {
  const servicio = SERVICIOS.find(s => s.slug === 'limpieza-periodica')!;
  const paths: { params: { municipio: string; barrio: string }; props: any }[] = [];
  for (const municipio of MUNICIPIOS) {
    if (municipio.comarca !== 'Ferrolterra') continue;
    if (!municipio.barrios) continue;
    for (const barrio of municipio.barrios) {
      if (!barrio.archetype) continue;
      const contenido = getContenidoPeriodica(barrio.archetype as BarrioArchetype, barrio.nombre, municipio.nombre);
      if (!contenido) continue;
      paths.push({
        params: { municipio: municipio.slug, barrio: barrio.slug },
        props: { servicio, municipio, barrio, contenido },
      });
    }
  }
  return paths;
}

const { servicio, municipio, barrio, contenido } = Astro.props;

const canonical = `${BUSINESS.url}/servicios/limpieza-periodica/${municipio.slug}/${barrio.slug}/`;
const hreflangEs = canonical;
const hreflangGl = `${BUSINESS.url}/gl/servizos/${servicio.slugGL}/${municipio.slug}/${barrio.slug}/`;
const ogImage = `${BUSINESS.url}/images/blog/limpieza-puntual-vs-periodica.webp`;

const title = `Limpieza Periódica en ${barrio.nombre}, ${municipio.nombre} · Empresa Local | Zentro Limpiezas`;
const description = `Servicio de limpieza periódica del hogar en ${barrio.nombre}. ${contenido.metaDesc} Presupuesto gratis en 24h, productos Ecolabel incluidos.`.slice(0, 160);

const breadcrumbs = [
  { label: 'Servicios', href: '/servicios/' },
  { label: servicio.nombre, href: `/servicios/${servicio.slug}/` },
  { label: municipio.nombre, href: `/servicios/${servicio.slug}/${municipio.slug}/` },
  { label: barrio.nombre, href: canonical },
];

const faqsLocales: { q: string; a: string }[] = [
  {
    q: `¿Cuánto cuesta la limpieza periódica en ${barrio.nombre}?`,
    a: `En ${barrio.nombre}, la limpieza periódica empieza desde 50€ por visita para pisos de 1-2 habitaciones, y desde 65€ para pisos de 3 habitaciones. Con contrato mensual aplicamos un 10% de descuento. Presupuesto cerrado en menos de 24 horas, sin letra pequeña.`,
  },
  {
    q: `¿Con qué frecuencia recomendáis el servicio de limpieza doméstica en ${barrio.nombre}?`,
    a: `Depende del tamaño del hogar y el número de personas. Para familias con niños en ${barrio.nombre} recomendamos visita quincenal. Parejas o personas solas suelen preferir una vez al mes. Si tienes mascotas, visita semanal o quincenal según el pelo que generen.`,
  },
  {
    q: `¿Traéis vosotros los productos de limpieza o tengo que tenerlos preparados en ${barrio.nombre}?`,
    a: `Traemos todo: productos Ecolabel certificados, mopas de microfibra, cubos y todo el material necesario. No tienes que preparar nada. Si prefieres algún producto específico que ya tengas en casa, podemos usarlo si nos lo indicas al contratar.`,
  },
  {
    q: `¿Puedo cancelar o cambiar el día de visita si tengo un imprevisto en ${barrio.nombre}?`,
    a: `Sí. Avisando con 24 horas de antelación recolocamos la visita sin coste. Los clientes con servicio periódico en ${barrio.nombre} tienen prioridad en la agenda para reasignaciones de última hora.`,
  },
];
const faqs = [...faqsLocales, ...contenido.faqs];

const waUrl = buildWhatsAppUrl(WA_MESSAGES.combo(servicio.nombre, barrio.nombre));

const otrosBarrios = (municipio.barrios ?? []).filter(
  b => b.slug !== barrio.slug && b.archetype && getContenidoPeriodica(b.archetype as BarrioArchetype, '', ''),
);

const serviciosRelacionados = [
  { nombre: 'Limpieza de pisos', slug: 'limpieza-de-pisos' },
  { nombre: 'Limpieza de viviendas', slug: 'limpieza-de-viviendas' },
  { nombre: 'Limpieza de cristales', slug: 'limpieza-de-cristales' },
];

const h1 = `Limpieza periódica en ${barrio.nombre}`;
---

<ComboLayout
  {title}
  {description}
  {canonical}
  {ogImage}
  lang="es"
  serviceName={`Limpieza periódica en ${barrio.nombre}, ${municipio.nombre}`}
  serviceDesc={description}
  price="50"
  {faqs}
  {breadcrumbs}
  {hreflangEs}
  hreflangGl={hreflangGl}
  areaServed={[barrio.nombre, municipio.nombre, municipio.comarca]}
>
  <HeroLocal
    municipio={barrio.nombre}
    servicio={servicio.nombre}
    eyebrow={`${servicio.nombre} · ${barrio.nombre}, ${municipio.nombre}`}
    {h1}
    qualifier={contenido.h1Qualifier}
    subtitle={contenido.intro}
    lang="es"
  />

  <section class="py-16 lg:py-24 bg-warm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <div class="lg:col-span-2 space-y-10">

          <!-- 01 · Por qué contratar servicio de limpieza periódica en este barrio -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">01</span>
              <h2 class="font-serif text-2xl lg:text-3xl text-primary">{contenido.porQueH2}</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>{contenido.porQueContent}</p>
              <p>{barrio.descripcion}</p>
            </div>
          </div>

          <!-- 02 · Qué incluye cada visita -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">02</span>
              <h2 class="font-serif text-2xl text-primary">{contenido.queIncluyeH2}</h2>
            </div>
            <ul class="space-y-3 text-mid">
              {contenido.queIncluyeItems.map(item => (
                <li class="flex items-start gap-3">
                  <span class="text-accent font-bold text-lg leading-tight mt-0.5 flex-shrink-0">✓</span>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
            <p class="text-mid text-sm mt-5 leading-relaxed">
              Todos los productos son Ecolabel con certificación europea. Sin olor a químico agresivo y sin riesgo para niños ni mascotas.
            </p>
          </div>

          <!-- Imagen optimizada -->
          <figure data-reveal class="rounded-xl overflow-hidden border border-line">
            <img
              src="/images/blog/limpieza-puntual-vs-periodica.webp"
              alt={`Servicio de limpieza periódica del hogar en ${barrio.nombre}, ${municipio.nombre} — Zentro Limpiezas`}
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
              class="w-full object-cover"
            />
            <figcaption class="text-xs text-mid text-center py-2 px-4">
              Limpieza periódica profesional en {barrio.nombre} · Zentro Limpiezas
            </figcaption>
          </figure>

          <!-- 03 · Frecuencia y precio -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">03</span>
              <h2 class="font-serif text-2xl text-primary">¿Cuánto cuesta la limpieza periódica del hogar en {barrio.nombre}?</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>{contenido.frecuencia}</p>
              <ul class="space-y-2 ml-4">
                {contenido.precioItems.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="text-accent font-bold mt-0.5">·</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="p-4 bg-white border border-line rounded-lg">
                <p class="text-sm text-charcoal">
                  <span class="font-semibold text-primary">Presupuesto cerrado, sin sorpresas.</span>{' '}
                  El precio que te damos es el precio final: incluye desplazamiento, productos y el tiempo necesario. Sin costes ocultos ni cobros extra por los materiales.
                </p>
              </div>
            </div>
          </div>

          <!-- 04 · Por qué elegirnos (LSI + trust) -->
          <div data-reveal>
            <div class="flex items-center gap-3 mb-5">
              <span class="section-number">04</span>
              <h2 class="font-serif text-2xl text-primary">¿Por qué contratar la limpieza doméstica en {barrio.nombre} con Zentro Limpiezas?</h2>
            </div>
            <div class="space-y-4 text-mid leading-relaxed">
              <p>
                Zentro Limpiezas es una empresa de limpieza con más de 20 años de experiencia en Ferrolterra. Trabajamos en {barrio.nombre} y en todo {municipio.nombre} con equipo propio, sin subcontrataciones. Nuestro servicio de limpieza doméstica periódica incluye las mismas limpiadoras en cada visita para que conozcan tu hogar y sepan dónde se acumula más suciedad.
              </p>
              <p>
                Si buscas un servicio de limpieza del hogar en {barrio.nombre} con presupuesto fijo, día reservado y productos ecológicos certificados, somos la opción que llevas buscando. Puedes contratar por visita o con contrato mensual flexible: sin permanencia mínima y con cancelación con 48 horas de aviso.
              </p>
              <div class="grid sm:grid-cols-3 gap-3 mt-4">
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">+20</p>
                  <p class="text-mid text-xs mt-1">años limpiando en Ferrolterra</p>
                </div>
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">24h</p>
                  <p class="text-mid text-xs mt-1">para darte presupuesto cerrado</p>
                </div>
                <div class="p-3 bg-white border border-line rounded-lg text-center">
                  <p class="text-accent font-bold text-xl">100%</p>
                  <p class="text-mid text-xs mt-1">productos Ecolabel certificados</p>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Aside -->
        <aside class="space-y-6 self-start">

          <div class="card p-6 border-accent/30 sticky top-24 z-10" data-reveal>
            <p class="font-serif text-lg text-primary mb-2 font-semibold">Limpieza periódica en {barrio.nombre}</p>
            <p class="text-mid text-xs mb-4">Presupuesto gratis · Sin compromiso · 24h</p>
            <div class="flex flex-col gap-2">
              <a href="/presupuesto/" class="btn-accent w-full text-center text-sm">→ Pedir presupuesto</a>
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full justify-center text-sm">
                WhatsApp {BUSINESS.phoneDisplay}
              </a>
            </div>
            <div class="mt-4 pt-4 border-t border-line">
              <EcoBadge size="sm" />
            </div>
          </div>

          <div class="card p-6" data-reveal>
            <p class="font-serif text-base text-primary mb-1 font-semibold">Limpieza periódica en todo {municipio.nombre}</p>
            <p class="text-mid text-xs mb-3">Precios y cobertura para todos los barrios.</p>
            <a href={`/servicios/limpieza-periodica/${municipio.slug}/`} class="text-sm text-accent hover:underline">
              → Limpieza periódica en {municipio.nombre}
            </a>
          </div>

          <!-- Servicios relacionados en el mismo barrio -->
          <div class="card p-6" data-reveal>
            <p class="font-serif text-base text-primary mb-3 font-semibold">Otros servicios en {barrio.nombre}</p>
            <ul class="space-y-2">
              {serviciosRelacionados.map(s => (
                <li>
                  <a href={`/servicios/${s.slug}/${municipio.slug}/${barrio.slug}/`} class="text-sm text-mid hover:text-primary hover:underline transition-colors">
                    → {s.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {otrosBarrios.length > 0 && (
            <div class="card p-6" data-reveal>
              <p class="font-serif text-base text-primary mb-3 font-semibold">Limpieza periódica en otros barrios de {municipio.nombre}</p>
              <ul class="space-y-2">
                {otrosBarrios.slice(0, 6).map(b => (
                  <li>
                    <a href={`/servicios/limpieza-periodica/${municipio.slug}/${b.slug}/`} class="text-sm text-mid hover:text-primary hover:underline transition-colors">
                      → {b.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="card p-4" data-reveal>
            <a href={`/zonas/${municipio.slug}/${barrio.slug}/`} class="text-xs text-mid hover:text-accent hover:underline transition-colors">
              → Todos los servicios disponibles en {barrio.nombre}
            </a>
          </div>

        </aside>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-charcoal">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-2xl lg:text-3xl text-warm mb-3 text-center" data-reveal>
        Preguntas frecuentes sobre limpieza periódica en {barrio.nombre}
      </h2>
      <p class="text-white/60 text-center mb-8" data-reveal>
        Llámanos al <a href={BUSINESS.phoneHref} class="text-accent hover:underline">{BUSINESS.phoneDisplay}</a> o escríbenos por WhatsApp si tienes más dudas.
      </p>
      <div class="space-y-3" data-reveal>
        {faqs.map((faq) => (
          <details class="bg-charcoal border border-white/10 rounded-lg group">
            <summary class="flex items-center justify-between gap-3 p-5 cursor-pointer list-none hover:text-white transition-colors">
              <h3 class="text-white/90 font-medium text-sm m-0 group-open:text-white">{faq.q}</h3>
              <span class="text-accent flex-shrink-0 text-lg group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="px-5 pb-5 text-white/70 text-sm leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactStrip context={`${barrio.nombre}, ${municipio.nombre}`} />
</ComboLayout>
